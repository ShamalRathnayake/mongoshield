{
  "name": "@mongoshield/provider-s3",
  "version": "0.0.2-alpha.0",
  "description": "AWS S3 and compatible storage provider for MongoShield.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShamalRathnayake/mongoshield.git",
    "directory": "packages/provider-s3"
  },
  "engines": {
    "node": ">= 20.x"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/lib-storage": "^3.1053.0",
    "@mongoshield/core": "workspace:*"
  }
}
