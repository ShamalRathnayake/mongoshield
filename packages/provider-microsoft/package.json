{
  "name": "@mongoshield/provider-microsoft",
  "version": "0.0.1-alpha.0",
  "description": "Microsoft Azure Blob Storage provider for MongoShield.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShamalRathnayake/mongoshield.git",
    "directory": "packages/provider-microsoft"
  },
  "engines": {
    "node": ">= 20.x"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.17.0",
    "@mongoshield/core": "workspace:*"
  }
}
