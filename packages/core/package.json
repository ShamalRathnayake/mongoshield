{
  "name": "@mongoshield/core",
  "version": "1.0.1-alpha.1",
  "description": "Core streaming, validation, and encryption logic for MongoShield.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShamalRathnayake/mongoshield.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">= 20.x"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "bson": "^7.2.0",
    "mongodb": "^7.1.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5"
  }
}
