{
  "name": "@mongoshield/provider-local",
  "version": "0.0.1",
  "description": "Local file system storage provider for MongoShield.",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.x"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@mongoshield/core": "workspace:*"
  }
}
