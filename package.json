{
  "name": "mongoshield-monorepo",
  "private": true,
  "engines": {
    "node": ">= 20.x"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "test": "vitest run",
    "release": "changeset publish",
    "docs": "typedoc",
    "commit": "git-cz",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,cts,mts,jsx,tsx,json,jsonc}": "biome check --write"
  },
  "author": "ShamalRathnayake",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@testcontainers/mongodb": "^11.14.0",
    "@types/node": "^25.6.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "testcontainers": "^11.14.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShamalRathnayake/mongoshield.git"
  },
  "bugs": {
    "url": "https://github.com/ShamalRathnayake/mongoshield/issues"
  },
  "homepage": "https://github.com/ShamalRathnayake/mongoshield#readme",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "7.3.2",
      "lodash": ">=4.18.0",
      "uuid": ">=14.0.0",
      "tmp": ">=0.2.4"
    }
  }
}
