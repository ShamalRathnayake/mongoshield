{
  "name": "mongoshield-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm --filter mongoshield dev",
    "test": "pnpm build:lib && pnpm --filter \"./packages/*\" test",
    "test:unit": "pnpm --filter \"./packages/*\" test:unit",
    "test:integration": "pnpm --filter \"./packages/*\" test:integration",
    "coverage": "pnpm build:lib && pnpm --filter \"./packages/*\" coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm build:lib && pnpm --filter \"./packages/*\" typecheck",
    "check:package": "pnpm --filter \"./packages/*\" check:package",
    "check": "pnpm lint && pnpm typecheck && pnpm --filter mongoshield docs:errors:check && pnpm test && pnpm build && pnpm check:package",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepare": "lefthook install",
    "docs:errors": "pnpm --filter mongoshield docs:errors",
    "docs:dev": "pnpm --filter website dev",
    "docs:build": "pnpm --filter website build",
    "build:lib": "pnpm --filter mongoshield build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.0",
    "lefthook": "^2.2.2"
  }
}
