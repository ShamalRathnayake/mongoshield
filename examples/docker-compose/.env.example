# Copy to .env (git-ignored) and adjust. Docker Compose reads it automatically.

# age public key to encrypt backups for. Create a pair with:
#   docker compose run --rm mongoshield keygen
# and store the printed secret key somewhere safe, outside this project.
BACKUP_PUBLIC_KEY=

# Uncomment to write backups to the local "backups" volume instead of MinIO.
# MONGOSHIELD_STORAGE=/backups

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
