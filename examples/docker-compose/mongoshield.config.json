{
  "storage": "s3://backups/compose?endpoint=http://minio:9000&forcePathStyle=true",
  "backup": {
    "exclude": ["*.sessions"],
    "labels": { "trigger": "docker-compose" }
  },
  "retention": { "last": 6, "hourly": 24, "daily": 7 },
  "schedule": {
    "cron": "*/10 * * * *",
    "lock": "storage",
    "verify": "fast",
    "retries": 2
  }
}
