# Copy to .env (git-ignored) and adjust. Docker Compose reads it automatically.

# Create the admin at the first start instead of on the setup page (headless installs).
# The password needs at least 12 characters. Ignored once any console user exists.
# MONGOSHIELD_ADMIN_USERNAME=admin
# MONGOSHIELD_ADMIN_PASSWORD=change-me-to-something-long

# Run a locally built image instead of the published one:
#   docker build -f docker/console.Dockerfile -t mongoshield-console:local ../..
# CONSOLE_IMAGE=mongoshield-console:local
